<Window x:Class="WinPilot.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="WinPilot"
        Width="1140"
        Height="760"
        MinWidth="920"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#0B0B0E"
        AllowDrop="True"
        DragOver="Host_DragOver"
        Drop="Host_Drop"
        Closing="Window_Closing">
    <Grid Background="#0B0B0E">
        <wv2:WebView2 x:Name="WebView" DefaultBackgroundColor="#0B0B0E" AllowExternalDrop="False" />
    </Grid>
</Window>
